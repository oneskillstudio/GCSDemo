---
// src/components/Footer.astro
---

<footer class="site-footer">
  <div class="footer-inner">
    <!-- LEFT: Brand Section -->
    <div class="footer-brand">
      <h3>OneSkill Studio</h3>
      <p>Oracle Fusion HCM expert knowledge base. Deep technical guides and functional expertise for enterprise implementations.</p>
      <div class="footer-social">
        <a href="https://linkedin.com/in/vaibhav-chavan" target="_blank" class="social-icon" title="LinkedIn">in</a>
        <a href="https://twitter.com/oneskill" target="_blank" class="social-icon" title="Twitter">𝕏</a>
        <a href="https://github.com/oneskillstudio" target="_blank" class="social-icon" title="GitHub">⚙️</a>
        <a href="mailto:vaibhav@oneskillstudio.com" class="social-icon" title="Email">✉</a>
      </div>
    </div>

    <!-- RIGHT: Navigation -->
    <div class="footer-nav">
      <div>
        <h4>Explore</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/blog/technical">Technical</a></li>
          <li><a href="/blog/functional">Functional</a></li>
          <li><a href="/blog/training">Trainings</a></li>
        </ul>
      </div>
      <div>
        <h4>More</h4>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/sitemap">Sitemap</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Legal -->
  <div class="footer-legal">
    <p>© 2024 OneSkill Studio. All rights reserved. | <a href="/privacy">Privacy Policy</a> | <a href="/terms">Terms of Service</a></p>
    <p>Personal views and do not represent any employer. Oracle and product names are trademarks of Oracle Corporation.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: white;
    border-top: 1px solid #ddd;
    padding: 2rem;
    margin-top: 4rem;
  }

  .footer-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-brand h3 {
    color: #003b66;
    margin: 0;
    font-size: 1.2rem;
  }

  .footer-brand p {
    color: #666;
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .footer-social {
    display: flex;
    gap: 1rem;
  }

  .social-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f0f0f0;
    border-radius: 50%;
    text-decoration: none;
    color: #003b66;
    font-weight: bold;
    transition: all 0.2s;
  }

  .social-icon:hover {
    background: #003b66;
    color: white;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .footer-nav h4 {
    color: #003b66;
    margin: 0 0 1rem 0;
    font-size: 1rem;
  }

  .footer-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-nav li {
    margin-bottom: 0.5rem;
  }

  .footer-nav a {
    color: #666;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: #0091b8;
  }

  .footer-legal {
    max-width: 1400px;
    margin: 0 auto;
    padding-top: 2rem;
    border-top: 1px solid #ddd;
    color: #999;
    font-size: 0.85rem;
  }

  .footer-legal a {
    color: #0091b8;
    text-decoration: none;
  }

  .footer-legal a:hover {
    text-decoration: underline;
  }

  .footer-legal p {
    margin: 0.5rem 0;
  }

  @media (max-width: 1024px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
