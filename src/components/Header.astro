---
// src/components/Header.astro
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo">
      <div class="logo-icon">O</div>
      <span>OneSkill Studio</span>
    </a>
    <nav class="nav">
      <a href="/">Home</a>
      <a href="/blog/technical">Technical</a>
      <a href="/blog/functional">Functional</a>
      <a href="/blog/training">Trainings</a>
      <a href="/about">About</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: white;
    border-bottom: 1px solid #ddd;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: #003b66;
    font-weight: bold;
    font-size: 1.2rem;
  }

  .logo-icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #003b66, #0091b8);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-weight: bold;
    font-size: 1.2rem;
  }

  .nav {
    display: flex;
    gap: 2rem;
  }

  .nav a {
    text-decoration: none;
    color: #666;
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .nav a:hover {
    color: #003b66;
  }

  @media (max-width: 768px) {
    .header-inner {
      flex-direction: column;
      gap: 1rem;
    }

    .nav {
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav a {
      font-size: 0.85rem;
    }
  }
</style>
